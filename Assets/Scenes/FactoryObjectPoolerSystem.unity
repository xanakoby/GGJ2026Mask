  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "questo \xE8 il Factory insieme all'object pooler, l'ObjectPooler \xE8
    interpolato nel Factory che si trova del game manager,\nil factory viene creato
    e inizializzato in GameManager e trammite il factory puoi fare il Create di quel
    che si vuole, ogni volta che voglio creare un nuovo oggetto che sia scriptableObject
    o non, va fatta un nuovo ObjectPooler, quindi quando vai a fare una nuova funzione
    di Create in Factory andr\xE0 fatto un nuovo objectPooler, e cosi avrai a disposizione
    un nuovo oggetto con scriptableObject, e nel caso l'oggetto creato abbia una
    classe in pi\xF9 si pu\xF2 avere la gestione della sua distruzione e messa in
    coda per l'object pooler al suo interno."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
    serializedVersion: 2
    rgba: 4294967295
  m_fontColor: {r: 1, g: 1, b: 1, a: 1}
  m_enableVertexGradient: 0
